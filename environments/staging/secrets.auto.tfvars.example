# Copy this to secrets.auto.tfvars (gitignored, never commit it) and fill
# in real values. OpenTofu writes these straight into Secrets Manager via
# write-only arguments — they never land in state or a plan diff, even
# though they're supplied as plain tfvars here. See IaC.md's Secrets & IAM
# section and prerequisites.md.
#
# Only needed before the first `tofu apply` that creates these secrets, or
# when rotating a value — bump the matching *_version number below
# whenever you change one, since OpenTofu has nothing stored to diff
# against otherwise.

api_token         = "REPLACE_WITH_A_LONG_RANDOM_TOKEN"
api_token_version = 1

voyage_api_key             = "REPLACE_WITH_VOYAGE_API_KEY"
imejis_api_key             = "REPLACE_WITH_IMEJIS_API_KEY"
vertex_service_account_key = "REPLACE_WITH_THE_RAW_GCP_SERVICE_ACCOUNT_KEY_JSON_CONTENT"

external_credentials_version = 1
